# Python/cache files
**/__pycache__/
*.pyc

# Virtual environments
.venv/
venv/

# Manim / generated media (never commit renders)
media/
**/media/
*.mp4
*.mov
*.wav
*.mp3

# Manim snapshot cache (build artifact, 50+ MB pickles). Scoped to the
# animations tree.
animations/**/cache/

# DaVinci Resolve local artifacts (per-project, machine-local binaries — never
# commit). Gallery stills / PowerGrades and the render cache are pointed here by
# the project's colorGalleryStillsLocation / perfCacheClipsLocation settings; a
# .drp is an editable project backup, never uploaded (see bpkfigures/PUBLISHING.md).
.gallery/
CacheClip/
*.drp
Resolve Project Backups/
# `render NN --stills` staging dir (anim copies + still PNGs + .swap versions).
edit_clips/

# Machine-local solver working data: resume checkpoints (.ckpt) and memo
# pickles, regenerable and potentially GBs. Committed results (final trees,
# csv logs) live under math/data/shared/ and ARE tracked.
math/data/local/

# OS / editor junk
.DS_Store

# Claude config (machine-local; recreated from dotclaude by /sync-videos —
# commands is a symlink, settings.local.json a real copy since symlinked settings
# files aren't loaded).
.claude/commands
.claude/settings.local.json

# Ignore notebook checkpoints
**/.ipynb_checkpoints/

# Optimal-solver resume checkpoints (machine-local, can be GBs, deleted on
# convergence). Regenerated by re-running; never commit.
*.ckpt

# CLAUDE.md import copies. CLAUDE.shared.md / CLAUDE.private.md are REAL COPIES of
# bpkfigures/CLAUDE.md + dotclaude/CLAUDE.md, refreshed every session start by
# dotclaude/hooks/refresh-claude-imports.py and pulled in by CLAUDE.md's @imports.
# They must be real files INSIDE the repo: a CLAUDE.md @import will not resolve to
# a target outside the project dir (not via ../, not via a symlink). They are
# machine-local like the rest of the Claude config. CLAUDE.private.md is
# private-repo content — keeping it ignored is what stops it being committed into
# a video repo (yahtzee and battleship are PUBLIC).
/CLAUDE.shared.md
/CLAUDE.private.md
